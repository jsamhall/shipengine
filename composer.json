{
  "name": "jsamhall/shipengine",
  "description": "A PHP wrapper for the accessing and interacting with the ShipEngine v1 API.",
  "license": "MIT",
  "keywords": [
    "shipengine",
    "shipstation"
  ],
  "authors": [
    {
      "name": "John Hall",
      "email": "john@johnhall.io"
    }
  ],
  "require": {
    "php": "^8.1",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "jsamhall\\ShipEngine\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "jsamhall\\ShipEngine\\Tests\\": "tests"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true
  }
}
